# Copy this file to .env and fill in the values. Never commit .env.

# Secret key the Siri Shortcut and wall screen send in the X-API-Key header.
# Make a long random one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Small, fast model used to extract task details.
AI_MODEL=claude-haiku-5-5

# Where tasks are stored. SQLite file by default.
DATABASE_URL=sqlite:///./tasks.db

# Your time zone, used to understand "Friday" or "tomorrow at 9".
APP_TIMEZONE=Europe/London
